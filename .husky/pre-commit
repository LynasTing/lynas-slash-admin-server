#!/usr/bin/env sh

set -eu

staged_java_files="$(git diff --cached --name-only --diff-filter=ACMR -- '*.java')"

# Re-staging a partially staged file would also stage its unrelated unstaged edits.
# Refuse that ambiguous state instead of silently changing the commit contents.
if [ -n "$staged_java_files" ]; then

	while IFS= read -r file; do
		if ! git diff --quiet -- "$file"; then
			echo "Cannot auto-format partially staged file: $file" >&2
			echo "Stage or stash its remaining edits, then commit again." >&2
			exit 1
		fi
	done <<EOF
$staged_java_files
EOF

	./mvnw -q spotless:apply

	while IFS= read -r file; do
		git add -- "$file"
	done <<EOF
$staged_java_files
EOF
fi

./mvnw -q validate
